[South "EPBot"]
[West "EPBot"]
[Dealer "E"]
[Vulnerable "None"]
[Deal "N:J52.87.AQ52.J942 A73.KT65.KJ86.AK KQT9.A432.73.653 864.QJ9.T94.QT87"]
[Scoring "MP"]
[Declarer "E"]
