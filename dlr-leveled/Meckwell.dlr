/*@chat
---  15-17 Notrump Opening and Meckwell action.
  • X   = !C, !D, !H & !S, or a good hand
  • 2!C = !C and a major
  • 2!D = !D and a major
  • 2!H = 5+ !H
  • 2!S = 5+ !S
  • 2N  = 5-5 or better in !C & !D
The Meckwell actions are leveled.  The NT opener is not leveled.
https://www.bridgebum.com/meckwell_defense_to_1nt.php
@chat*/

dealer east

### gibNT changed from south to east
# GIB opens 1N w/15-17 HCP or 15-16 and a 5-card major
ntP = hcp(east) + shape(east,5xxx+x5xx)
nt1 = shape(east, any 5332+any 4432+any 4333) and hcp(east)>14 and ntP<18

# GIB does not open with 5422 and a 5-card major
# GIB does not open with 5422 and the strength to reverse
nt2 = shape(east, 4252+4225+2452+2425+2254+2245) and hcp(east)>14 and hcp(east)<17

gibNT = nt1 or nt2

# Defines gibNT

# Define South's good suits
sGS = top2(south,spades)>0   and top4(south,spades)>1   and top5(south,spades)>2
sGH = top2(south,hearts)>0   and top4(south,hearts)>1   and top5(south,hearts)>2
sGD = top2(south,diamonds)>0 and top4(south,diamonds)>1 and top5(south,diamonds)>2
sGC = top2(south,clubs)>0    and top4(south,clubs)>1    and top5(south,clubs)>2

# Define South's suit lengths
sS = spades(south)
sH = hearts(south)
sD = diamonds(south)
sC = clubs(south)

# Define South's shapes
majorAndLongerC   = ((sGS and sS>3) or (sGH and sH>3)) and sGC and sC>sS and sC>sH 
majorAndLongerD   = ((sGS and sS>3) or (sGH and sH>3)) and sGD and sD>sS and sD>sH 
bothMajors        = sGS and sGH and shape(south,66xx+65xx+56xx+55xx+54xx+45xx)
oneSuit           = shape(south,any 9xxx+any 8xxx+any 7xxx+any 6xxx+any 5xxx-any 76xx-any 75xx-any 65xx-any 4xxx)

goodHand          = oneSuit and (sGS or sGH or sGD or sGC) and hcp(south)>15
oneMinor          = oneSuit and (sGD or sGC) and shape(south,any 0xxx+any 1xxx)
heartSuit         = oneSuit and sGH and shape(south,any 0xxx+any 1xxx)
spadeSuit         = oneSuit and sGS and shape(south,any 0xxx+any 1xxx)
bothMinors        = sGD and sGC and shape(south,xx76+xx67+xx66+xx65+xx56+xx55+xx54+xx45)

# Define South's Meckwell action
cX  = oneMinor or bothMajors or goodHand
c2C = not cX and majorAndLongerC             
c2D = not cX and majorAndLongerD             
c2H = not cX and heartSuit
c2S = not cX and spadeSuit
c2N = bothMinors

# Define Leveling
# 5-5 in the minors is 2N. oneSuit counts a 5-5 hand as one-suited (it
# excludes 76/75/65 but not 55), which also made it an X through oneMinor.
HandType_X = cX and not c2N
HandType_C = c2C
HandType_D = c2D
# sGH/sGS are suit quality, not length, so a short strong suit sets heartSuit or
# spadeSuit too. The chat's 2H/2S show 5+: where both are set, the longer suit bids.
HandType_H = c2H and not (c2S and sS > sH)
HandType_S = c2S and not (c2H and sH >= sS)
# bothMinors takes 5-4 too, but the chat's 2N is 5-5 or better: a 5-4 minor
# hand with a four-card major is 2C/2D (a minor and a major)
HandType_N = c2N and not (c2C or c2D)

### BEGIN GENERATED LEVELING ###
# Generated by dealer --write-leveled. Do not edit; edit the stock
# scenario and regenerate, or the two will disagree without saying so.
#
# measured over  85023 deals, seed 1
#
# type    natural    target     keep      seen
# X       0.57461   0.16667   0.0409     48855
# C       0.02765   0.16667   0.8507      2351
# D       0.02807   0.16667   0.8379      2387
# H       0.17269   0.16667   0.1362     14683
# S       0.17345   0.16667   0.1356     14747
# N       0.02352   0.16667   1.0000      2000
#
# exactness      1.000  (full)
# acceptance     0.1411 of qualifying deals
# cost           about 6085 deals dealt per deal kept
# precision      keeps set by N, the rarest, seen 2000 times (+-2.2%); expect the mix within +-0.37 points

roll = (rnd(1000) % 1000 + 1000) % 1000

level_X = HandType_X and roll < 41
level_C = HandType_C and roll < 851
level_D = HandType_D and roll < 838
level_H = HandType_H and roll < 136
level_S = HandType_S and roll < 136
level_N = HandType_N
levelTheDeal = level_X or level_C or level_D or level_H or level_S or level_N
### END GENERATED LEVELING ###

# Now OPEN 1NT
gibNT and (cX or c2C or c2D or c2H or c2S or c2N) and hcp(south)>9
and levelTheDeal

# Generate Statistics
action printoneline,
average "X    " 100 * cX,
average "2C   " 100 * c2C,
average "2D   " 100 * c2D,
average "2H   " 100 * c2H,
average "2S   " 100 * c2S,
average "2N   " 100 * c2N,
frequency  "HCP South "  (hcp(south) , 9, 20),
