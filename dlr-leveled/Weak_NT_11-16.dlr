/*@chat
--- South has a semi-balanced hand with 11-16 HCP and not 5/4 in the majors
@chat*/

produce 1000
dealer south

hcp1113 = hcp(south)>10 and hcp(south)<14
hcp1416 = hcp(south)>13 and hcp(south)<17

HandType_1113 = hcp1113
HandType_1416 = hcp1416

### BEGIN GENERATED LEVELING ###
# Generated by dealer --write-leveled. Do not edit; edit the stock
# scenario and regenerate, or the two will disagree without saying so.
#
# measured over  5540 deals, seed 1
#
# type    natural    target     keep      seen
# 1113    0.63899   0.50000   0.5650      3540
# 1416    0.36101   0.50000   1.0000      2000
#
# exactness      1.000  (full)
# acceptance     0.7220 of qualifying deals
# cost           about 7 deals dealt per deal kept
# precision      keeps set by 1416, the rarest, seen 2000 times (+-1.8%); expect the mix within +-0.89 points

roll = (rnd(1000) % 1000 + 1000) % 1000

level_1113 = HandType_1113 and roll < 565
level_1416 = HandType_1416
levelTheDeal = level_1113 or level_1416
### END GENERATED LEVELING ###

# South has a semi-balanced hand with 9-12 HCP and not 5/4 in majors
shape(south,any 4333 +any 4432 +any 5332 +any 5422 -54xx -45xx) and hcp(south)>10 and hcp(south)<17
and levelTheDeal

produce 5000
action printoneline,
average "11-13 " 100 * hcp1113,
average "14-16 " 100 * hcp1416,
