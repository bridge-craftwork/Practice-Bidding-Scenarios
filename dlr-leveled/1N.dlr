# leveled-from: dlr/1N.dlr sha256:9623c596c8fdd695d94e3071b57864a332239cc97ea2f1e2fe95f718c5ad3584
# alias: Notrump
# button-text: 15-17 1N (Lev)
# scenario-title: ---  15-17 Notrump Opening
# gib-works: false
# bba-works: true
# auction-filter: Auction.....\n1NT?
# convention-card-ns: 21GF-DEFAULT
# convention-card-ew: 21GF-GIB

/*@chat
---  15-17 Notrump Opening
2452+2425+2245+2254+4522 +any 4333, 4432, or 5332 distribution.
Those 5422 hands are the ones where you are likely to have to reverse to show your suits.
HCP adjusted +1 for any 5-card suit unless you have Kx, Qx, or Jx doubleton.
@chat*/

dealer south

# Import Define-1N and Leveling
### Imported: Define 1 Notrump Opening ###

# Calculate length points for South (lengthPoints)
lp1 = spades(south)>4 ? spades(south)-4 : 0
lp2 = hearts(south)>4 ? hearts(south)-4 : 0
lp3 = diamonds(south)>4 ? diamonds(south)-4 : 0
lp4 = clubs(south)>4 ? clubs(south)-4 : 0
lengthPoints = lp1 or lp2 or lp3 or lp4

# Calculate doubleton honor NT downgrade(s) for South -- 2 cards, 1 honor, not the Ace
S2H = spades(south)==2 and   top4(south,spades)>0   and not hascard(south,AS) ? 1 : 0
H2H = hearts(south)==2 and   top4(south,hearts)>0   and not hascard(south,AH) ? 1 : 0
D2H = diamonds(south)==2 and top4(south,diamonds)>0 and not hascard(south,AD) ? 1 : 0
C2H = clubs(south)==2 and    top4(south,clubs)>0    and not hascard(south,AC) ? 1 : 0
dgPoints = S2H + H2H + D2H + C2H

# Define notrump points for south (ntPoints)
ntPoints = lengthPoints>dgPoints ? hcp(south) + lengthPoints - dgPoints : hcp(south)

ntMin = ntPoints<16
ntAvg = ntPoints==16
ntMax = ntPoints>16

# Define 1NT -- these include hands that might have rebid problems if opened in a suit
NT = shape(south, 2452+2425+2245+2254+4522 +any 4333+any 4432+any 5332) and ntPoints>14 and ntPoints<18

### End of Imported 1 Notrump ###

# Level it
HandType_Min = ntMin
HandType_Avg = ntAvg
HandType_Max = ntMax

### BEGIN GENERATED LEVELING ###
# Generated by dealer --write-leveled. Do not edit; edit the stock
# scenario and regenerate, or the two will disagree without saying so.
#
# measured over  8314 deals, seed 1
#
# type    natural    target     keep      seen
# Min     0.42795   0.33333   0.5621      3558
# Avg     0.33149   0.33333   0.7257      2756
# Max     0.24056   0.33333   1.0000      2000
#
# exactness      1.000  (full)
# acceptance     0.7217 of qualifying deals
# cost           about 25 deals dealt per deal kept
# precision      keeps set by Max, the rarest, seen 2000 times (+-1.9%); expect the mix within +-0.65 points

roll = (rnd(1000) % 1000 + 1000) % 1000

level_Min = HandType_Min and roll < 562
level_Avg = HandType_Avg and roll < 726
level_Max = HandType_Max
levelTheDeal = level_Min or level_Avg or level_Max
### END GENERATED LEVELING ###

### Ready for Leveling

# Now OPEN 1NT

NT
and levelTheDeal

# Generate Statistics
action printoneline,

average "Minimum     " 100 * ntMin,
average "Avg         " 100 * ntAvg,
average "Max         " 100 * ntMax,

frequency  "HCP South "  (hcp(south) , 14, 18),
frequency  "ntPoints  "  (ntPoints   , 14, 18),
