# leveled-from: dlr/Opps_Double_Stayman.dlr sha256:bfbb749a1fd1d8b69d3c9d9eedac9ab78a9ea9f3365019b35187483693f76d92
# alias: StaymanX
# button-text: X Stayman
# scenario-title: --- Opponents X Stayman
# gib-works: true
# bba-works: true
# auction-filter: Auction.....\n1N +Pass +2C.* X
# convention-card-ns: 21GF-DEFAULT
# convention-card-ew: 21GF-GIB

/*@chat
--- Opponents X Stayman
@chat*/

# Opponents Double Stayman
dealer south
produce 1000

# Define South's NT opening -- robot style
sNT = shape(south, any 4333 +any 4432 +any 5332-5xxx-x5xx) and hcp(south)>14 and hcp(south)<18

# North responds 2C -- w/45xx GIB transfers to H and bids S
n2C = shape(north, 54xx+44xx+43xx+34xx+42xx+24xx) and hcp(north)>8

# East doubles
oneSuit = shape(east,any 7xxx+any 6xxx+any 5xxx-any 75xx-any 66xx-any 65xx-any 55xx)
eDoubles = ((clubs(east)>4 and top4(east,clubs)==3) or (clubs(east)>5 and top4(east,clubs)==2)) and hcp(east)>8 and oneSuit

# Reduce long club suits
HandType_5 = clubs (east) ==5
HandType_More = clubs (east) >5

### BEGIN GENERATED LEVELING ###
# Generated by dealer --write-leveled. Do not edit; edit the stock
# scenario and regenerate, or the two will disagree without saying so.
#
# measured over  7911 deals, seed 1
#
# type    natural    target     keep      seen
# 5       0.25281   0.50000   1.0000      2000
# More    0.74719   0.50000   0.3384      5911
#
# exactness      1.000  (full)
# acceptance     0.5056 of qualifying deals
# cost           about 29545 deals dealt per deal kept
# precision      keeps set by 5, the rarest, seen 2000 times (+-1.9%); expect the mix within +-0.97 points

roll = (rnd(1000) % 1000 + 1000) % 1000

level_5 = HandType_5
level_More = HandType_More and roll < 338
levelTheDeal = level_5 or level_More
### END GENERATED LEVELING ###

sNT and n2C and eDoubles
and levelTheDeal

action printoneline,

average "South hcp    " hcp(south),
average "North hcp    " hcp(north),
average "East Clubs=5 " 100 * (clubs(east)==5),
average "East Clubs>5 " 100 * (clubs(east)>5),
