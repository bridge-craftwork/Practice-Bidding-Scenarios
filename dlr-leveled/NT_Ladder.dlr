# leveled-from: dlr/NT_Ladder.dlr sha256:c43c5d90adb6cd2bd88a46ca6fa872b92b57e59ebb3711c49f4722b6deaf3b1f
# alias: NTLadder
# button-text: NT Ladder (Lev)
# scenario-title: --- NT Ladder (Lev)
# gib-works: true
# bba-works: true
# auction-filter: Auction.....\n[1-7]
# convention-card-ns: 21GF-DEFAULT
# convention-card-ew: 21GF-GIB

/*@chat
--- NT Ladder (Lev)
Practice balanced hand evaluation across the full NT opening range.
Five HCP ranges, leveled to:
• 12-14 HCP (20%) - Open 1 of a suit, then rebid 1NT
• 15-17 HCP (20%) - Standard 1NT opening
• 18-19 HCP (20%) - Too strong for 1NT, open 1x then rebid 2NT
• 20-21 HCP (20%) - Open 2NT
• 22-24 HCP (20%) - Open 2C then rebid 2NT
@chat*/

produce 5000
dealer south

# Balanced shape for South
balanced = shape(south, any 4333 + any 4432 + any 5332)

# Define HCP ranges
hcp12_14 = hcp(south) >= 12 and hcp(south) <= 14
hcp15_17 = hcp(south) >= 15 and hcp(south) <= 17
hcp18_19 = hcp(south) >= 18 and hcp(south) <= 19
hcp20_21 = hcp(south) >= 20 and hcp(south) <= 21
hcp22_24 = hcp(south) >= 22 and hcp(south) <= 24

# Level the ranges (12-14 is most common, 22-24 is rarest)
HandType_12_14 = hcp12_14
HandType_15_17 = hcp15_17
HandType_18_19 = hcp18_19
HandType_20_21 = hcp20_21
HandType_22_24 = hcp22_24

### BEGIN GENERATED LEVELING ###
# Generated by dealer --write-leveled. Do not edit; edit the stock
# scenario and regenerate, or the two will disagree without saying so.
#
# measured over  158323 deals, seed 1
#
# type     natural    target     keep      seen
# 12_14    0.58301   0.20000   0.0217     92304
# 15_17    0.29260   0.20000   0.0432     46326
# 18_19    0.07961   0.20000   0.1587     12604
# 20_21    0.03214   0.20000   0.3930      5089
# 22_24    0.01263   0.20000   1.0000      2000
#
# exactness      1.000  (full)
# acceptance     0.0632 of qualifying deals
# cost           about 95 deals dealt per deal kept
# precision      keeps set by 22_24, the rarest, seen 2000 times (+-2.2%); expect the mix within +-0.44 points

roll = (rnd(1000) % 1000 + 1000) % 1000

level_12_14 = HandType_12_14 and roll < 22
level_15_17 = HandType_15_17 and roll < 43
level_18_19 = HandType_18_19 and roll < 159
level_20_21 = HandType_20_21 and roll < 393
level_22_24 = HandType_22_24
levelTheDeal = level_12_14 or level_15_17 or level_18_19 or level_20_21 or level_22_24
### END GENERATED LEVELING ###

##### Now do it #####
condition
balanced and hcp(south) >= 12 and hcp(south) <= 24
and levelTheDeal

action printoneline,
average "1. 12-14 HCP" 100 * hcp12_14,
average "2. 15-17 HCP" 100 * hcp15_17,
average "3. 18-19 HCP" 100 * hcp18_19,
average "4. 20-21 HCP" 100 * hcp20_21,
average "5. 22-24 HCP" 100 * hcp22_24,

frequency "HCP South " (hcp(south), 12, 24),
