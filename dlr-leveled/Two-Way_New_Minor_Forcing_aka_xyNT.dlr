# convention-card-ns: 21GF-DEFAULT
# convention-card-ew: 21GF-GIB

/*@chat
---  Two Way New Minor Forcing aka xyNT allows you to describe four different responding hand types.
  • Part Score  -- after 1x-1y-1N, 2!H or 2!S ane natural and non-forcing, 2N relays to 3!C P/C.
  • Game Invite -- after 1x-1y-1N, bid 2!C, an artifical relay to 2!D.  Then, all continuations are invitational.
  • Game Force  -- after 1x-1y-1N, bid 2!D, an artifical game force.
  • Slam Invite -- after 1x-1y-1N, a suit bid at the 3-level is a natural slam try.
The deals are leveled so that the hand types occur at about the same frequency.
https://bridgewinners.com/article/view/two-way-new-minor-forcing-aka-xynt
@chat*/

produce 300000
dealer north

# Two Way New Minor Forcing, aka xyNT
# Predict North's opening suit
sN = spades(north)
hN = hearts(north)
dN = diamonds(north)
cN = clubs(north)
nS = sN>4 and sN>=hN and sN>=dN and sN>=cN
nH = not nS and hN>4 and hN>=dN and hN>=cN
nD = not nS and not nH and ((dN>3 and dN>=cN))
nC = not nS and not nH and not nD
northOpens = (nC or nD or nH) and hcp(north)>11 and hcp(north)<15 and shape(north,any 4333+any 4432+any 5332+any 5422 -5xxx)

# Predict South's responding suit
s = spades(south)
h = hearts(south)
d = diamonds(south)
c = clubs(south)
sS = s>=h and s>=d and s>=c
sH = not sS and h>=d and h>=c
sD = not sS and not sH and d>=c and d>4

cO = nC and (sD or sH or sS)
dO = nD and (sH or sS)
hO = nH and sS

# North opens, South responds, and North rebids 1N
southResponds = (cO or dO or hO)
partscore   = hcp(south)<11
invite      = hcp(south)>10 and hcp(south)<13
game        = hcp(south)>12 and hcp(south)<18
slam        = hcp(south)>17

##### Imported Script: Define Calm Opponents #####

# Avoid concentration of values
cce = top4(east,clubs)<2
cde = top4(east,diamonds)<2
che = top4(east,hearts)<2
cse = top4(east,spades)<2
noConEast = cce and cde and che and cse

ccw = top4(west,clubs)<2
cdw = top4(west,diamonds)<2
chw = top4(west,hearts)<2
csw = top4(west,spades)<2
noConWest = ccw and cdw and chw and csw

balEast    = shape(east,any 4432 +any 4333)
unbalEast  = shape(east,xxxx -any 4432 -any 4333 -any 9xxx -any 8xxx -any 7xxx-any 6xxx -any 55xx)

balWest    = shape(west,any 4432 +any 4333)
unbalWest  = shape(west,xxxx -any 4432 -any 4333 -any 9xxx -any 8xxx -any 7xxx-any 6xxx -any 55xx)

calmEast = (unbalEast and noConEast and hcp(east)<8) or (balEast and hcp(east)<11)
calmWest = (unbalWest and noConWest and hcp(west)<8) or (balWest and hcp(west)<11)
calmOpps = calmEast and calmWest

##### End of Imported Script: Define Calm Opponents #####

HandType_Partscore = partscore
HandType_Invite = invite
HandType_Game = game
HandType_Slam = slam

### BEGIN GENERATED LEVELING ###
# Generated by dealer --write-leveled. Do not edit; edit the stock
# scenario and regenerate, or the two will disagree without saying so.
#
# measured over  24640 deals, seed 1
#
# type         natural    target     keep      seen
# Partscore    0.20475   0.25000   0.3964      5045
# Invite       0.24099   0.25000   0.3368      5938
# Game         0.47309   0.25000   0.1716     11657
# Slam         0.08117   0.25000   1.0000      2000
#
# exactness      1.000  (full)
# acceptance     0.3247 of qualifying deals
# cost           about 514 deals dealt per deal kept
# precision      keeps set by Slam, the rarest, seen 2000 times (+-2.1%); expect the mix within +-0.54 points

roll = (rnd(1000) % 1000 + 1000) % 1000

level_Partscore = HandType_Partscore and roll < 396
level_Invite = HandType_Invite and roll < 337
level_Game = HandType_Game and roll < 172
level_Slam = HandType_Slam
levelTheDeal = level_Partscore or level_Invite or level_Game or level_Slam
### END GENERATED LEVELING ###

northOpens and southResponds and calmOpps and (partscore or invite or game or slam)
and levelTheDeal

action printoneline,
average "partscore " 100 * partscore,
average "invite    " 100 * invite,
average "game      " 100 * game,
average "slam      " 100 * slam,
