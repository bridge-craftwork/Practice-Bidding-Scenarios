# alias: WeakNT11to16
# button-text: WeakNT 11-16
# gib-works: false
# bba-works: false
# auction-filter: Auction.....\n1NT?
# convention-card-ns: Precision
# convention-card-ew: 21GF-GIB

/*@chat
--- South has a semi-balanced hand with 11-16 HCP and not 5/4 in the majors
@chat*/

produce 1000
dealer south

hcp1113 = hcp(south)>10 and hcp(south)<14
hcp1416 = hcp(south)>13 and hcp(south)<17

HandType_1113 = hcp1113
HandType_1416 = hcp1416

### BEGIN GENERATED LEVELING ###
noLeveling = 1
levelTheDeal = noLeveling
### END GENERATED LEVELING ###

# South has a semi-balanced hand with 9-12 HCP and not 5/4 in majors
shape(south,any 4333 +any 4432 +any 5332 +any 5422 -54xx -45xx) and hcp(south)>10 and hcp(south)<17
and levelTheDeal

produce 5000
action
average "11-13 " 100 * hcp1113,
average "14-16 " 100 * hcp1416,
