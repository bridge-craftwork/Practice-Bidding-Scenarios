# leveled-from: dlr/Grand_Slam_Invite.dlr sha256:58b6745edaeaf6eff843b65901e63e515d1273459217ef878e39c683da64f04d
# alias: GrandSlamInviteBal
# button-text: Grand Slam?
# scenario-title: --- Grand Slam Invite (lev)
# gib-works: true
# bba-works: true
# auction-filter: .
# convention-card-ns: 21GF-DEFAULT
# convention-card-ew: 21GF-GIB

/*@chat
--- Grand Slam Invite (lev)
Both hands are balanced and have a combined hcp very near Grand Slam.
@chat*/

dealer south

# 1 Notrump GIB
produce 10000

# Use GIB style 1N for 15-17 NT & just balanced for all other ranges

# GIB opens 1N w/15-17 HCP or 15-16 and a 5-card major
p = hcp(south) + shape(south,5xxx+x5xx)
nt1 = shape(south, any 5332+any 4432+any 4333) and hcp(south)>14 and p<18
# GIB does not open with 5422 and a 5-card major
# GIB does not open with 5422 and the strength to reverse
nt2 = shape(south, 4252+4225+2452+2425+2254+2245) and hcp(south)>14 and hcp(south)<17

ntShape = shape(south, any 5332+any 4432+any 4333)
nt1214 = ntShape and hcp(south)>11 and hcp(south)<15
nt1517 = nt1 or nt2
nt1819 = ntShape and hcp(south)>17 and hcp(south)<20
nt2021 = ntShape and hcp(south)>19 and hcp(south)<22
nt2224 = ntShape and hcp(south)>21 and hcp(south)<25
nt2527 = ntShape and hcp(south)>24 and hcp(south)<28
nt28   = ntShape and hcp(south)>27

nShape = shape(north, any 5332+any 4432+any 4333)
totalHCP = hcp(north) + hcp(south)

HandType_1214 = nt1214
HandType_1517 = nt1517
HandType_1819 = nt1819
HandType_2021 = nt2021
HandType_2224 = nt2224
HandType_2527 = nt2527
HandType_28 = nt28

### BEGIN GENERATED LEVELING ###
# Generated by dealer --write-leveled. Do not edit; edit the stock
# scenario and regenerate, or the two will disagree without saying so.
#
# measured over  135092 deals, seed 1
#
# type    natural    target     keep      seen
# 1214    0.13007   0.14286   0.1138     17571
# 1517    0.23648   0.14286   0.0626     31947
# 1819    0.19929   0.14286   0.0743     26922
# 2021    0.18014   0.14286   0.0822     24336
# 2224    0.17430   0.14286   0.0849     23547
# 2527    0.06491   0.14286   0.2281      8769
# 28      0.01480   0.14286   1.0000      2000
#
# exactness      1.000  (full)
# acceptance     0.1036 of qualifying deals
# cost           about 74597 deals dealt per deal kept
# precision      keeps set by 28, the rarest, seen 2000 times (+-2.2%); expect the mix within +-0.32 points

roll = (rnd(1000) % 1000 + 1000) % 1000

level_1214 = HandType_1214 and roll < 114
level_1517 = HandType_1517 and roll < 63
level_1819 = HandType_1819 and roll < 74
level_2021 = HandType_2021 and roll < 82
level_2224 = HandType_2224 and roll < 85
level_2527 = HandType_2527 and roll < 228
level_28 = HandType_28
levelTheDeal = level_1214 or level_1517 or level_1819 or level_2021 or level_2224 or level_2527 or level_28
### END GENERATED LEVELING ###

ntShape and totalHCP>35
and (HandType_1214 or HandType_1517 or HandType_1819 or HandType_2021 or HandType_2224 or HandType_2527 or HandType_28) and levelTheDeal

produce 10000

action printoneline,
average "HCP South " hcp(south),
average "HCP North " hcp(north),
average "totalHCP  " totalHCP,
average "nt1214    " 100 * nt1214,
average "nt1517    " 100 * nt1517,
average "nt1819    " 100 * nt1819,
average "nt2021    " 100 * nt2021,
average "nt2224    " 100 * nt2224,
average "nt2527    " 100 * nt2527,
average "nt28++    " 100 * nt28,
